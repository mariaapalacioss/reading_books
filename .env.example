# Frontend (se incluyen en el build de Vite; la anon key es pública por diseño de Supabase)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
# En GitHub Pages del repo reading_books usa /reading_books/
# En local deja /
VITE_BASE=/
# PDFs más grandes se guardan en IndexedDB del navegador (plan Free Supabase ≈ 50 MB por archivo).
# Si subes el límite global en Supabase (Pro), sube este valor en MB, p. ej. 150.
VITE_MAX_PDF_CLOUD_MB=50
# Puente OAuth local (Sign in with ChatGPT). npm run dev lo inicia en 127.0.0.1:1455
VITE_CHATGPT_BRIDGE_URL=http://127.0.0.1:1455

# Multi-usuario: por defecto el análisis y el chat usan el plan ChatGPT de CADA usuario (OAuth en el navegador).
# Solo activa esto en despliegues personales donde TÚ pagas la API para todos (no recomendado en producción compartida).
# VITE_ALLOW_SERVER_OPENAI=true

# Secretos SOLO del servidor (Supabase → Edge Functions → Secrets).
# No los pongas en el frontend ni en el workflow de GitHub Pages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase las inyecta solas en las Edge Functions. Aquí quedan como referencia local.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=
